# EWS DevOps Support Application - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
# Backend proxy server port
BACKEND_PORT=3001

# Frontend development server port
FRONTEND_PORT=3000

NODE_ENV=development

# PostgreSQL Database (GCP - EWSADM Schema)
DB_HOST=your-gcp-postgres-host
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-db-username
DB_PASSWORD=your-db-password

# Oracle KB Database
KB_ORACLE_USER=your-kb-username
KB_ORACLE_PASSWORD=your-kb-password
KB_ORACLE_CONNECT_STRING=your-kb-connection-string

# Oracle SEMS Database
SEMS_ORACLE_USER=your-sems-username
SEMS_ORACLE_PASSWORD=your-sems-password
SEMS_ORACLE_CONNECT_STRING=your-sems-connection-string

# Shared OAuth Token URL (used by all services)
ACCESS_TOKEN_URL=https://apigw-pr.tsl.telus.com/token

# EWSMA OAuth Configuration
EWSMA_OAUTH_CLIENT_ID=your-ewsma-client-id
EWSMA_OAUTH_CLIENT_SECRET=your-ewsma-client-secret

# EWSMA API Configuration
EWSMA_API_BASE_URL=https://your-ewsma-api-url
EWSMA_API_ENVIRONMENT=IT01
EWSMA_API_SOURCE_APP_ID=EWS_DEVOPS_SUPPORT
EWSMA_OAUTH_SCOPE=ewsma.warranty.write

# EW Maintenance API Configuration
EW_MAINTENANCE_API_BASE_URL=https://your-ew-maintenance-api-url
EW_MAINTENANCE_API_ENVIRONMENT=IT01
EW_MAINTENANCE_OAUTH_SCOPE=ew.maintenance.write

# Asurion API Configuration
# Uses same OAuth credentials as EWSMA services
# Base URL used for both enrollment create and cancel operations
ASURION_ENROLLMT_API_BASE_URL=https://apigw-private-nane-pr-001.tsl.telus.com/common/assurionenrollment/v1/mobility/enrollment
ASURION_ENROLLMT_OAUTH_SCOPE=1919
ASURION_TELUS_PARTNER_ID=48604F94A51244B6E053A239030ABFB9
ASURION_KOODO_PARTNER_ID=48604F94A51444B6E053A239030ABFB9

# WLS Product Inventory Management API (EWPOQ)
EWPOQ_OAUTH_CLIENT_ID=your-ewpoq-client-id
EWPOQ_OAUTH_CLIENT_SECRET=your-ewpoq-client-secret
WLS_PROD_INV_API_BASE_URL=https://your-wls-product-api-url/product/wlsProductInventoryManagement/v1
WLS_PROD_INV_OAUTH_SCOPE=150

# WLS Customer Offering Instance Management API (Remove SOC)
WLS_CUST_OFFRNG_API_BASE_URL=https://your-wls-customer-offering-api-url/product/wlsCustomerOfferingInstanceManagement/v1
WLS_CUST_OFFRNG_OAUTH_SCOPE=3758

# Token Management
TOKEN_EXPIRY_IN_SECS=3600
TOKEN_REFRESH_BEFORE_EXPIRY_IN_SECS=300

# Frontend Configuration
# Backend API URL (for frontend to connect to backend proxy server)
VITE_BACKEND_URL=http://localhost:3001
