### 3. Service Pattern

**Backend Services follow factory pattern:**
```typescript
class ServiceName {
  private config: ServiceConfig;
  private tokenManager: OAuth2TokenManager;

  constructor(config: ServiceConfig) {
    this.config = config;
    this.tokenManager = new OAuth2TokenManager(config.oauth);
  }

  async performAction(data: RequestData): Promise<ResponseData> {
    const authToken = await this.tokenManager.getAuthorizationTokenString();
    // API call logic
  }
}

export function createServiceName(): ServiceName {
  const config = {
    apiBaseUrl: process.env.API_BASE_URL!,
    environment: process.env.API_ENVIRONMENT!,
    oauth: {
      tokenUrl: process.env.ACCESS_TOKEN_URL!,
      clientId: process.env.OAUTH_CLIENT_ID!,
      clientSecret: process.env.OAUTH_CLIENT_SECRET!,
      scope: process.env.OAUTH_SCOPE!,
      tokenExpiryInSecs: parseInt(process.env.TOKEN_EXPIRY_IN_SECS!),
      gracePeriodInSecs: parseInt(process.env.TOKEN_REFRESH_BEFORE_EXPIRY_IN_SECS!)
    }
  };
  return new ServiceName(config);
}
```

**Frontend API clients:**
```typescript
import axios from 'axios';

const BASE_URL = import.meta.env.VITE_BACKEND_URL;

export const apiFunction = async (params: ParamType): Promise<ResponseType> => {
  try {
    const response = await axios.post(`${BASE_URL}/api/endpoint`, params);
    return response.data;
  } catch (error) {
    if (axios.isAxiosError(error)) {
      return {
        success: false,
        error: error.response?.data?.error || error.message
      };
    }
    throw error;
  }
};
```

### 4. Custom Hooks Pattern

```typescript
export const useCustomHook = () => {
  const [state, setState] = useState<StateType>({
    isProcessing: false,
    error: null
  });

  const performAction = async (params: ParamType): Promise<ResultType> => {
    console.log('[HOOK_NAME] Start:', { params });
    setState({ isProcessing: true, error: null });

    try {
      // Step 1: First API call
      console.log('[HOOK_NAME] Step 1: Action description...');
      const step1Result = await apiCall1(params);
      
      // Step 2: Second API call
      console.log('[HOOK_NAME] Step 2: Action description...');
      const step2Result = await apiCall2(params);

      console.log('[HOOK_NAME] Complete:', { success: step2Result.success });
      setState({ isProcessing: false, error: null });

      return {
        success: step2Result.success,
        message: 'Action completed',
        details: step2Result.details
      };
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Unknown error';
      console.error('[HOOK_NAME] Error:', { params, error: errorMessage });
      setState({ isProcessing: false, error: errorMessage });

      return {
        success: false,
        message: 'Error during action',
        details: errorMessage
      };
    }
  };

  const reset = () => {
    setState({ isProcessing: false, error: null });
  };

  return { performAction, state, reset };
};
```

### 5. OAuth2 Token Management

- **Centralized token management** via `OAuth2TokenManager` class
- **Automatic token refresh** with configurable grace period
- **Token expiry tracking** to prevent expired token usage
- **Shared across all external API services** (EW Maintenance, Asurion, WLS)

### 6. Database Connection Patterns

**PostgreSQL (EWS Database):**
```typescript
import pool from '../../config/ewsDatabase';

export const queryDatabase = async (params: ParamType): Promise<ResultType> => {
  const query = `SELECT * FROM table WHERE condition = $1`;
  const values = [params.value];
  
  const result = await pool.query(query, values);
  return result.rows;
};
```

**Oracle (KB Database):**
```typescript
import { getOracleConnection } from '../../config/kbDatabase';

export const queryOracle = async (params: ParamType): Promise<ResultType> => {
  const connection = await getOracleConnection();
  
  try {
    const result = await connection.execute(
      `SELECT * FROM table WHERE condition = :value`,
      { value: params.value }
    );
    return result.rows;
  } finally {
    await connection.close();
  }
};
```

